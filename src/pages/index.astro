---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentRole, homeLead, site } from '../data/site';
---

<BaseLayout title={site.name} description={homeLead} path="/">
  <section class="hero">
    <div>
      <p class="eyebrow">{site.location}</p>
      <h1>{site.name}</h1>
      <p class="lead">{homeLead}</p>
    </div>
    <img
      class="portrait"
      src={site.profileImage}
      width="192"
      height="256"
      alt={site.profileAlt}
      fetchpriority="high"
    />
  </section>

  <section class="callout" aria-labelledby="current-role">
    <p class="eyebrow">Current role</p>
    <h2 id="current-role">
      <a href={currentRole.href} rel="noopener noreferrer">{currentRole.company}</a>
    </h2>
    <p>{currentRole.title}</p>
    <p class="meta">{currentRole.domain} · {currentRole.timeline} · {currentRole.place}</p>
    <p class="note">{currentRole.note}</p>
  </section>

  <ul class="action-row">
    <li><a class="button button-solid" href="/about">About</a></li>
    <li><a class="button" href="/projects">Projects</a></li>
    <li><a class="button" href={site.cv.href} download={site.cv.fileName}>{site.cv.label}</a></li>
  </ul>
</BaseLayout>

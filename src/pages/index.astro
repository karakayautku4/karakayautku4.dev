---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyLogo from '../components/CompanyLogo.astro';
import { currentRole, homeLead, site } from '../data/site';
---

<BaseLayout title={site.name} description={homeLead} path="/">
  <section class="hero">
    <div>
      <p class="eyebrow">{site.location}</p>
      <h1 class="lead">{homeLead}</h1>
    </div>
    <img
      class="portrait"
      src={site.profileImage}
      width="192"
      height="256"
      alt={site.profileAlt}
      fetchpriority="high"
    />
  </section>

  <section class="callout" aria-labelledby="current-role">
    <p class="eyebrow">Current role</p>
    <h2 id="current-role">
      <a class="company-link" href={currentRole.href} rel="noopener noreferrer">
        <CompanyLogo logo={currentRole.logo} size="callout" />
        <span class="visually-hidden">{currentRole.company}</span>
      </a>
    </h2>
    <p>{currentRole.title}</p>
    <p class="meta">{currentRole.domain} · {currentRole.timeline} · {currentRole.place}</p>
    <p class="note">{currentRole.note}</p>
  </section>

  <ul class="action-row">
    <li><a class="button button-solid" href="/about">About</a></li>
    <li><a class="button button-solid" href={site.cv.href} download={site.cv.fileName}>{site.cv.label}</a></li>
    <li>
      <a class="button" href={site.contact.href} rel="me noopener noreferrer">{site.contact.label}</a>
    </li>
  </ul>
</BaseLayout>

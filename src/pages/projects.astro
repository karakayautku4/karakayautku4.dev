---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/site';

const description = projects.paragraphs[0];

type RepoCard = {
  name: string;
  description: string | null;
  language: string | null;
  href: string;
};

let repos: RepoCard[] = [];

try {
  const response = await fetch(
    'https://api.github.com/users/karakayautku4/repos?sort=updated&per_page=30',
    {
      headers: {
        Accept: 'application/vnd.github+json',
        'User-Agent': 'karakayautku4.dev',
      },
    },
  );

  if (response.ok) {
    const data: unknown = await response.json();
    if (Array.isArray(data)) {
      repos = data
        .filter((repo): repo is Record<string, unknown> => {
          return Boolean(repo) && typeof repo === 'object' && repo.fork !== true;
        })
        .filter((repo) => typeof repo.name === 'string' && typeof repo.html_url === 'string')
        .slice(0, 6)
        .map((repo) => ({
          name: String(repo.name),
          description:
            typeof repo.description === 'string' && repo.description.trim()
              ? repo.description.trim()
              : null,
          language: typeof repo.language === 'string' ? repo.language : null,
          href: String(repo.html_url),
        }));
    }
  }
} catch {
  repos = [];
}
---

<BaseLayout title={projects.title} description={description} path="/projects">
  <header class="intro projects-copy">
    <p class="eyebrow">Projects</p>
    <h1>{projects.title}</h1>
    {projects.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p>
      <a class="button button-solid" href={projects.githubHref} rel="noopener noreferrer">
        {projects.githubLabel}
      </a>
    </p>
  </header>

  {
    repos.length > 0 && (
      <ul class="repo-grid">
        {repos.map((repo) => (
          <li>
            <a class="repo-card" href={repo.href} rel="noopener noreferrer">
              <h2>{repo.name}</h2>
              {repo.description && <p>{repo.description}</p>}
              {repo.language && <p class="repo-language">{repo.language}</p>}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
